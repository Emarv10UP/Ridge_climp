# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://ridgeclimb:ridgeclimb@localhost:5432/ridgeclimb?schema=public"

# JWT (for future admin auth)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (SMTP) — leave SMTP_HOST blank to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RidgeClimb Adventures <info@ridgeclimb.kg>"
ADMIN_EMAIL=info@ridgeclimb.kg
